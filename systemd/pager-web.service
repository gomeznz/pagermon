[Unit]
Description=MultipagePlus web interface
After=network.target

[Service]
Type=simple
User=pager
Group=pager
EnvironmentFile=/etc/multipage/multipage.env
WorkingDirectory=/opt/multipage
ExecStart=/opt/multipage/venv/bin/python -m app.web
Restart=always
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/multipage
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
